LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

VO_LLM_PROVIDER=openrouter
VO_LLM_MODEL=openai/gpt-4o-mini
VO_OPENROUTER_API_KEY=
VO_OPENAI_API_KEY=                # set both keys to enable provider failover
VO_LLM_FALLBACK_MODEL=gpt-4o-mini
VO_LLM_ATTEMPT_TIMEOUT=4.0

VO_STT_MODEL=large-v3-turbo
VO_STT_LANGUAGE=en
VO_LANGUAGES=["en","hi"]
VO_HINDI_STT=indic
VO_INDIC_DECODING=ctc
VO_TTS_VOICE=af_heart
VO_TTS_HINDI_VOICE=hf_alpha
VO_DENOISER=rnnoise

VO_TURN_DETECTOR=multilingual
VO_INTERRUPT_MIN_DURATION=0.4
VO_FALSE_INTERRUPTION_TIMEOUT=1.0
VO_BACKCHANNEL_MAX_WORDS=3

VO_AGENT_NAME=
VO_TRANSFER_NUMBER=
VO_ORDERS_PATH=data/orders.json
VO_USER_AWAY_TIMEOUT=12
VO_SIP_VAD_ACTIVATION=0.35
VO_SIP_INTERRUPT_MIN_DURATION=0.5

VO_PREEMPTIVE_GENERATION=true
VO_OTEL_ENDPOINT=
